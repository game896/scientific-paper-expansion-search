# Copy to .env and fill in. .env is never committed.

# Required when LLM_PROVIDER or EMBEDDING_PROVIDER is "gemini"
GEMINI_API_KEY=

# Providers: gemini | fake (llm, embeddings); openalex | fake (source)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
SOURCE_PROVIDER=openalex

GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Vector size (max 3072). Changing it later means re-embedding everything.
EMBEDDING_DIMENSIONS=768
# Free tier allows 100 texts per minute; raise this on a paid plan
EMBEDDING_TEXTS_PER_MINUTE=90

# Optional: your email gives you OpenAlex's faster "polite pool"
OPENALEX_EMAIL=

# Storage and seed
CHROMA_PATH=data/chroma
SEED_PATH=seed.yaml
# Remembers the last run, fetched authors and which papers belong to which author/journal
STATE_PATH=data/state.json

# Pipeline limits
MAX_PAPERS=3000
# Similarity to the field description. At or above THRESHOLD a paper is accepted; below FLOOR it is
# rejected; in between Gemini is asked. Gemini scores everything high (unrelated text is about 0.65).
RELEVANCE_THRESHOLD=0.80
RELEVANCE_FLOOR=0.70

LOG_LEVEL=INFO
